<Window x:Class="LyricIsland.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LyricIsland.UI.Controls"
        mc:Ignorable="d"
        Title="Settings – lysyn"
        Height="660" Width="880"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0E"
        Foreground="#FAFAFA"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Clean Solid Styles (Zero Gradients) -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0B0E" />
        <SolidColorBrush x:Key="ContainerBg" Color="#121217" />
        <SolidColorBrush x:Key="CardBg" Color="#181820" />
        <SolidColorBrush x:Key="CardBorder" Color="#242430" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F4F5" />
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />
        <SolidColorBrush x:Key="InputBg" Color="#1E1E28" />
        <SolidColorBrush x:Key="InputBorder" Color="#2D2D3D" />

        <!-- Clean Solid Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- Clean Solid CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <!-- Clean Solid TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E28" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="BorderBrush" Value="#2D2D3D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Clean Solid ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E28" />
            <Setter Property="Foreground" Value="#181820" />
            <Setter Property="BorderBrush" Value="#2D2D3D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <!-- Main Rounded Container matching reference design -->
        <Border Background="{StaticResource ContainerBg}"
                CornerRadius="16"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Sub-nav + Content Body -->
                    <RowDefinition Height="*" />
                    <!-- Footer Actions -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- TOP HEADER -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="24,18">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Logo / App Icon (Theme Colored) -->
                            <Border x:Name="HeaderLogoBorder"
                                    Width="36" Height="36"
                                    CornerRadius="10"
                                    Background="#1A1A24"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1"
                                    Margin="0,0,14,0">
                                <Image x:Name="HeaderLogoImage"
                                       Width="22" Height="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="lysyn"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Configure appearance, companions, and media integration"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MIDDLE BODY: SIDEBAR + CONTENT -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Left Navigation Sidebar -->
                        <ColumnDefinition Width="200" />
                        <!-- Divider Line -->
                        <ColumnDefinition Width="1" />
                        <!-- Right Content Area -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT SUB-NAVIGATION SIDEBAR -->
                    <Grid Grid.Column="0" Background="#101015">
                        <DockPanel LastChildFill="False" Margin="14,18">
                            <!-- Vertical Tabs Stack -->
                            <StackPanel DockPanel.Dock="Top">
                                <Button x:Name="NavThemeBtn"
                                        Click="NavThemeBtn_Click"
                                        Height="38"
                                        Margin="0,0,0,6"
                                        HorizontalContentAlignment="Left"
                                        Padding="14,0"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder"
                                                    CornerRadius="8"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎨" Margin="0,0,8,0" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Theme &amp; Colors" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavGifBtn"
                                        Click="NavGifBtn_Click"
                                        Height="38"
                                        Margin="0,0,0,6"
                                        HorizontalContentAlignment="Left"
                                        Padding="14,0"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder"
                                                    CornerRadius="8"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✨" Margin="0,0,8,0" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="GIF Companion" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavNotchBtn"
                                        Click="NavNotchBtn_Click"
                                        Height="38"
                                        Margin="0,0,0,6"
                                        HorizontalContentAlignment="Left"
                                        Padding="14,0"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder"
                                                    CornerRadius="8"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖥️" Margin="0,0,8,0" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Notch &amp; Display" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavLyricsBtn"
                                        Click="NavLyricsBtn_Click"
                                        Height="38"
                                        Margin="0,0,0,6"
                                        HorizontalContentAlignment="Left"
                                        Padding="14,0"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder"
                                                    CornerRadius="8"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎵" Margin="0,0,8,0" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Lyrics &amp; Timing" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavIntegrationBtn"
                                        Click="NavIntegrationBtn_Click"
                                        Height="38"
                                        Margin="0,0,0,6"
                                        HorizontalContentAlignment="Left"
                                        Padding="14,0"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder"
                                                    CornerRadius="8"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙️" Margin="0,0,8,0" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Integration" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Bottom Reset Button -->
                            <Button DockPanel.Dock="Bottom"
                                    x:Name="ResetDefaultsBtn"
                                    Click="ResetDefaultsButton_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#EF4444"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Padding="6,8"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↺" Margin="0,0,6,0" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="Reset to Defaults" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Grid>

                    <!-- VERTICAL DIVIDER LINE -->
                    <Border Grid.Column="1" Background="{StaticResource CardBorder}" />

                    <!-- RIGHT CONTENT AREA -->
                    <Grid Grid.Column="2" Background="{StaticResource ContainerBg}">
                        <!-- TAB 1: THEME & COLORS -->
                        <ScrollViewer x:Name="TabThemeGrid"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="24,20"
                                      Visibility="Visible">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                                <!-- Card: Color Mode & Presets -->
                                <Border Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Accent Theme Color"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Choose a solid color preset or fine-tune with the hue slider. Recolors visualizer, media controls, lyrics, and this window."
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,4,0,14"
                                                   TextWrapping="Wrap" />

                                        <!-- Solid Preset Buttons -->
                                        <TextBlock Text="Solid Color Presets:"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,0,0,8" />
                                        
                                        <WrapPanel Margin="0,0,0,16">
                                            <Button x:Name="SolidRed" Click="SolidRed_Click" Margin="0,0,8,8" Height="30" Padding="12,0" Background="#EF4444" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                                <TextBlock Text="Red" FontSize="11" FontWeight="Bold"/>
                                            </Button>
                                            <Button x:Name="SolidOrange" Click="SolidOrange_Click" Margin="0,0,8,8" Height="30" Padding="12,0" Background="#F97316" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                                <TextBlock Text="Orange" FontSize="11" FontWeight="Bold"/>
                                            </Button>
                                            <Button x:Name="SolidYellow" Click="SolidYellow_Click" Margin="0,0,8,8" Height="30" Padding="12,0" Background="#EAB308" Foreground="Black" BorderThickness="0" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                                <TextBlock Text="Yellow" FontSize="11" FontWeight="Bold"/>
                                            </Button>
                                            <Button x:Name="SolidGreen" Click="SolidGreen_Click" Margin="0,0,8,8" Height="30" Padding="12,0" Background="#22C55E" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                                <TextBlock Text="Green" FontSize="11" FontWeight="Bold"/>
                                            </Button>
                                            <Button x:Name="SolidCyan" Click="SolidCyan_Click" Margin="0,0,8,8" Height="30" Padding="12,0" Background="#06B6D4" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                                <TextBlock Text="Cyan" FontSize="11" FontWeight="Bold"/>
                                            </Button>
                                            <Button x:Name="SolidBlue" Click="SolidBlue_Click" Margin="0,0,8,8" Height="30" Padding="12,0" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                                <TextBlock Text="Blue" FontSize="11" FontWeight="Bold"/>
                                            </Button>
                                            <Button x:Name="SolidPurple" Click="SolidPurple_Click" Margin="0,0,8,8" Height="30" Padding="12,0" Background="#A855F7" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                                <TextBlock Text="Purple" FontSize="11" FontWeight="Bold"/>
                                            </Button>
                                            <Button x:Name="SolidPink" Click="SolidPink_Click" Margin="0,0,8,8" Height="30" Padding="12,0" Background="#EC4899" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                                <TextBlock Text="Pink" FontSize="11" FontWeight="Bold"/>
                                            </Button>
                                            <Button x:Name="SolidWhite" Click="SolidWhite_Click" Margin="0,0,8,8" Height="30" Padding="12,0" Background="#F4F4F5" Foreground="#09090B" BorderThickness="0" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                                <TextBlock Text="White" FontSize="11" FontWeight="Bold"/>
                                            </Button>
                                        </WrapPanel>

                                        <!-- Hue Slider (Clean Solid Track, Zero Gradient) -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Hue Slider:" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Border Grid.Column="1" Background="#22222E" CornerRadius="4" Height="8" VerticalAlignment="Center">
                                                <Slider x:Name="HueSlider"
                                                        Minimum="0" Maximum="360" Value="30"
                                                        SmallChange="1" LargeChange="15"
                                                        ValueChanged="HueSlider_ValueChanged"
                                                        Margin="-6,0,-6,0" />
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       x:Name="HueValueText"
                                                       Text="30Â°"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="#F97316"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Active Swatch & Hex Readout -->
                                        <Border Background="#121218" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="ThemeColorSwatch" Width="22" Height="22" CornerRadius="5" Background="#F97316" Margin="0,0,10,0"/>
                                                <TextBlock Text="Active Accent: " FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ThemeHexText" Text="#F97316" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Card: Live Notch Preview -->
                                <Border Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Live Appearance Preview"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="A preview of how your chosen color renders in the dynamic notch island."
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,4,0,14" />

                                        <!-- Mock Notch Island -->
                                        <Border Background="#09090D"
                                                BorderBrush="#252532"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="18,12"
                                                HorizontalAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Visualizer Mock -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <Ellipse x:Name="PreviewVisualizerDot" Width="10" Height="10" Fill="#F97316" Margin="0,0,4,0"/>
                                                    <Ellipse Width="6" Height="6" Fill="#4B5563" Margin="0,0,4,0"/>
                                                    <Ellipse Width="8" Height="8" Fill="#4B5563"/>
                                                </StackPanel>

                                                <!-- Center Lyrics & Controls Mock -->
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PreviewLyricText"
                                                               Text="â™ª And I, your willing victim"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FB923C"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,6" />
                                                    <Border x:Name="PreviewPlayBtn"
                                                            Width="26" Height="26"
                                                            CornerRadius="7"
                                                            Background="#F97316"
                                                            HorizontalAlignment="Center">
                                                        <Path Data="M8 5v14l11-7z" Fill="Black" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Right Badge Mock -->
                                                <Border Grid.Column="2" Background="#161620" CornerRadius="6" Padding="6,3" VerticalAlignment="Center">
                                                    <TextBlock Text="Preview" FontSize="11" Foreground="#9CA3AF"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- TAB 2: GIF COMPANION -->
                        <ScrollViewer x:Name="TabGifGrid"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="24,20"
                                      Visibility="Collapsed">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                                <Border Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Right Character Companion"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Choose an animated GIF to accompany your music island on the right notch edge."
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,4,0,14" />

                                        <!-- GIF Path Row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="GifPathBox"
                                                     Grid.Column="0"
                                                     TextChanged="GifPathBox_TextChanged"
                                                     Margin="0,0,8,0" />
                                            <Button Grid.Column="1"
                                                    Content="Browse..."
                                                    Click="BrowseGif_Click"
                                                    Background="#22222E"
                                                    Foreground="{StaticResource TextPrimary}"
                                                    BorderBrush="{StaticResource CardBorder}"
                                                    BorderThickness="1"
                                                    Padding="14,6"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <!-- Companion Presets -->
                                        <TextBlock Text="Included Character Presets:"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Button Content="Chika (Default)" Click="PresetChika_Click" Margin="0,0,8,0" Background="#22222E" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="12,6" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                            </Button>
                                            <Button Content="Arisu (Blue Archive)" Click="PresetArisu_Click" Margin="0,0,8,0" Background="#22222E" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="12,6" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                            </Button>
                                            <Button Content="Cat Playing" Click="PresetCat_Click" Margin="0,0,8,0" Background="#22222E" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="12,6" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                            </Button>
                                            <Button Content="Bunny Playing" Click="PresetBunny_Click" Background="#22222E" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="12,6" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                            </Button>
                                        </StackPanel>

                                        <!-- Flip Horizontally Check -->
                                        <CheckBox x:Name="GifFlipCheck"
                                                  Content="Flip character horizontally (mirror)"
                                                  Checked="GifFlipCheck_Changed"
                                                  Unchecked="GifFlipCheck_Changed"
                                                  Margin="0,0,0,16" />

                                        <!-- Playback Speed -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Playback Speed:" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Slider x:Name="AnimSpeedSlider"
                                                    Grid.Column="1"
                                                    Minimum="0.25" Maximum="3.0" Value="1.0"
                                                    TickFrequency="0.25"
                                                    ValueChanged="AnimSpeedSlider_ValueChanged" />
                                            <TextBlock Grid.Column="2"
                                                       x:Name="AnimSpeedText"
                                                       Text="{Binding ElementName=AnimSpeedSlider, Path=Value, StringFormat={}{0:F1}x}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Companion Preview Card -->
                                <Border Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Companion Preview"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <Border Background="#101015"
                                                BorderBrush="{StaticResource CardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Height="140"
                                                Margin="0,10,0,0">
                                            <Grid>
                                                <controls:GifPlayer x:Name="PreviewGif"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   MaxHeight="120"
                                                                   MaxWidth="160" />
                                                <TextBlock x:Name="PreviewPlaceholder"
                                                           Text="No companion loaded"
                                                           Foreground="#6B7280"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- TAB 3: NOTCH & DISPLAY -->
                        <ScrollViewer x:Name="TabNotchGrid"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="24,20"
                                      Visibility="Collapsed">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                                <Border Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Geometry &amp; Position"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Customize default width and height of the closed notch bar."
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,4,0,14" />

                                        <!-- Width Slider -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Notch Width:" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            <Slider x:Name="WidthSlider"
                                                    Grid.Column="1"
                                                    Minimum="240" Maximum="600" Value="360"
                                                    SmallChange="10" LargeChange="40" />
                                            <TextBlock Grid.Column="2"
                                                       x:Name="WidthValueText"
                                                       Text="{Binding ElementName=WidthSlider, Path=Value, StringFormat={}{0:F0} px}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Height Slider -->
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Notch Height:" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            <Slider x:Name="HeightSlider"
                                                    Grid.Column="1"
                                                    Minimum="32" Maximum="90" Value="40"
                                                    SmallChange="2" LargeChange="10" />
                                            <TextBlock Grid.Column="2"
                                                       x:Name="HeightValueText"
                                                       Text="{Binding ElementName=HeightSlider, Path=Value, StringFormat={}{0:F0} px}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Recenter Notch Button -->
                                        <Button Content="Recenter Notch to Screen Top"
                                                Click="RecenterButton_Click"
                                                Background="#22222E"
                                                Foreground="{StaticResource TextPrimary}"
                                                BorderThickness="0"
                                                Padding="14,8"
                                                HorizontalAlignment="Left"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Expansion Behavior"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Control how and when the notch expands to reveal media controls."
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,4,0,14" />

                                        <CheckBox x:Name="AutoExpandCheck"
                                                  Content="Auto-expand notch on mouse hover"
                                                  Margin="0,0,0,8" />
                                        <CheckBox x:Name="PinExpandedCheck"
                                                  Content="Keep notch permanently expanded" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- TAB 4: LYRICS & TIMING -->
                        <ScrollViewer x:Name="TabLyricsGrid"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="24,20"
                                      Visibility="Collapsed">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                                <Border Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Typography"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Select the font and size for rendered synchronized lyric lines."
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,4,0,14" />

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Font Family:" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="FontFamilyCombo" Height="32"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Font Size:" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            <Slider x:Name="MainFontSizeSlider"
                                                    Grid.Column="1"
                                                    Minimum="10" Maximum="24" Value="13"
                                                    SmallChange="1" LargeChange="2" />
                                            <TextBlock Grid.Column="2"
                                                       x:Name="FontSizeValueText"
                                                       Text="{Binding ElementName=MainFontSizeSlider, Path=Value, StringFormat={}{0:F0} pt}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Sync Timing Offset"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Offset lyric timestamps to compensate for Bluetooth latency or audio processing delays."
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,4,0,14" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Offset:" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            <Slider x:Name="TimingOffsetSlider"
                                                    Grid.Column="1"
                                                    Minimum="-3000" Maximum="3000" Value="0"
                                                    SmallChange="50" LargeChange="250" />
                                            <TextBlock Grid.Column="2"
                                                       x:Name="TimingOffsetText"
                                                       Text="0 ms"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="-500 ms" Click="DecOffsetBtn_Click" Margin="0,0,8,0" Background="#22222E" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="12,6" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                            </Button>
                                            <Button Content="0 ms (Reset)" Click="ResetOffsetBtn_Click" Margin="0,0,8,0" Background="#22222E" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="12,6" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                            </Button>
                                            <Button Content="+500 ms" Click="IncOffsetBtn_Click" Background="#22222E" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="12,6" Cursor="Hand">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Lyrics Cache"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Purge cached synchronized lyrics files from your local storage."
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,4,0,14" />
                                        <Button Content="Clear Cached Lyrics Files"
                                                Click="ClearCacheBtn_Click"
                                                Background="#22222E"
                                                Foreground="{StaticResource TextPrimary}"
                                                BorderThickness="0"
                                                Padding="14,8"
                                                HorizontalAlignment="Left"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- TAB 5: INTEGRATION -->
                        <ScrollViewer x:Name="TabIntegrationGrid"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="24,20"
                                      Visibility="Collapsed">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                                <Border Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Configure how lysyn behaves alongside Windows applications and games."
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Control startup, click-through, and window interactions."
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,4,0,14" />

                                        <CheckBox x:Name="AlwaysOnTopCheck"
                                                  Content="Always on top (visible over other windows)"
                                                  Margin="0,0,0,8" />
                                        <CheckBox x:Name="ClickThroughCheck"
                                                  Content="Click-through mode (transparent to mouse clicks)"
                                                  Margin="0,0,0,8" />
                                        <CheckBox x:Name="AutoHideFullscreenCheck"
                                                  Content="Auto-hide when a full-screen app or game is active"
                                                  Margin="0,0,0,8" />
                                        <CheckBox x:Name="StartWithWindowsCheck"
                                                  Content="Start lysyn automatically when Windows boots" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Global Hotkeys"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="System-wide keyboard shortcuts to control the island."
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,4,0,14" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Toggle Visibility:" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" x:Name="ToggleHotkeyBox" Text="Ctrl+Alt+L" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Toggle Click-Through:" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" x:Name="ClickThroughHotkeyBox" Text="Ctrl+Alt+T" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- FOOTER ACTIONS -->
                <Border Grid.Row="2"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="0,1,0,0"
                        Padding="24,14"
                        Background="#0F0F14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelButton"
                                    Content="Cancel"
                                    Click="CancelButton_Click"
                                    Background="#1D1D27"
                                    Foreground="#A1A1AA"
                                    BorderThickness="0"
                                    Padding="18,8"
                                    Margin="0,0,10,0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="SaveButton"
                                    Content="Save &amp; Apply"
                                    Click="SaveButton_Click"
                                    Background="#F97316"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="22,8"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="LyricIsland.UI.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LyricIsland.UI.Controls"
        mc:Ignorable="d"
        Title="lysyn"
        Height="44" Width="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonUp="Window_MouseRightButtonUp">

    <Window.Resources>
        <!-- Theme Ambient Glow -->
        <DropShadowEffect x:Key="IslandGlow" x:Name="IslandGlowEffect"
                          Color="#F59E0B"
                          BlurRadius="24"
                          ShadowDepth="2"
                          Opacity="0.25" />

        <DropShadowEffect x:Key="TextGlow" x:Name="TextGlowEffect"
                          Color="#FBBF24"
                          BlurRadius="10"
                          ShadowDepth="0"
                          Opacity="0.8" />

        <DropShadowEffect x:Key="PlayBtnGlow" x:Name="PlayBtnGlowEffect"
                          Color="#F59E0B"
                          BlurRadius="12"
                          ShadowDepth="0"
                          Opacity="0.55" />

        <!-- Media Vector Button Styles -->
        <Style x:Key="TransportBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="18" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Squircle Play/Pause Button inspired by user reference -->
        <Style x:Key="PlaySquircleBtn" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <!-- Squircle / Rounded Square with dynamic theme background -->
                            <Border x:Name="BgBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="13"
                                    Effect="{StaticResource PlayBtnGlow}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BgBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer root for shadow margin -->
    <Grid Margin="6,0,6,8">
        <!-- Main Pitch Black Island Border -->
        <Border x:Name="IslandContainer"
                Background="#000000"
                BorderBrush="#222224"
                BorderThickness="1.2"
                CornerRadius="0,0,24,24"
                Effect="{StaticResource IslandGlow}"
                ClipToBounds="True">

            <Grid>
                <!-- 1. COMPACT NOTCH VIEW (Shown when collapsed at top) -->
                <Grid x:Name="CompactNotchGrid" Height="36" VerticalAlignment="Top" Visibility="Visible" Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Active Media Source Icon on Left (Spotify, YouTube, YouTube Music, Apple Music, Generic) -->
                    <Grid Grid.Column="0" Width="18" Height="18" Margin="4,0,8,0" VerticalAlignment="Center">
                        <!-- Spotify Compact Logo -->
                        <Grid x:Name="CompactSpotifyLogoGrid" Width="18" Height="18" Visibility="Visible">
                            <Ellipse Fill="#1DB954" Width="18" Height="18"/>
                            <Path Stroke="#000000" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 4.2 6.5 C 7.8 5.2 12.2 5.7 15.0 7.7"/>
                            <Path Stroke="#000000" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 5.0 10.0 C 8.1 9.0 11.9 9.4 14.1 10.9"/>
                            <Path Stroke="#000000" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 5.7 13.0 C 8.2 12.3 11.2 12.6 13.0 13.8"/>
                        </Grid>

                        <!-- YouTube Video / Standard Compact Logo (Red rounded rect + centered white play triangle) -->
                        <Grid x:Name="CompactYouTubeStandardLogoGrid" Width="18" Height="18" Visibility="Collapsed">
                            <Viewbox Width="18" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="20" Height="14">
                                    <Rectangle Width="20" Height="14" RadiusX="4.2" RadiusY="4.2" Fill="#FF0000"/>
                                    <Path Fill="#FFFFFF" Data="M 7.5 3.5 L 13.5 7 L 7.5 10.5 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <!-- YouTube Music Compact Logo (Red circle + centered white concentric ring + play triangle) -->
                        <Grid x:Name="CompactYouTubeMusicLogoGrid" Width="18" Height="18" Visibility="Collapsed">
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="20" Height="20">
                                    <Ellipse Width="20" Height="20" Fill="#FF0000"/>
                                    <Ellipse Canvas.Left="4" Canvas.Top="4" Width="12" Height="12" Stroke="#FFFFFF" StrokeThickness="1.4"/>
                                    <Path Fill="#FFFFFF" Data="M 8.5 6.5 L 13 10 L 8.5 13.5 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <!-- Apple Music Compact Logo -->
                        <Grid x:Name="CompactAppleLogoGrid" Width="18" Height="18" Visibility="Collapsed">
                            <Ellipse Fill="#FA2D48" Width="18" Height="18"/>
                            <Path Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 6.8 5.0 L 11.8 3.6 L 11.8 10.8 C 11.2 10.5 10.5 10.4 9.8 10.4 C 8.4 10.4 7.3 11.4 7.3 12.6 C 7.3 13.8 8.4 14.8 9.8 14.8 C 11.2 14.8 12.4 13.8 12.4 12.6 L 12.4 6.2 L 7.8 7.5 Z"/>
                        </Grid>

                        <!-- Generic Media Compact Icon -->
                        <Grid x:Name="CompactGenericLogoGrid" Width="18" Height="18" Visibility="Collapsed">
                            <Ellipse Fill="#27272A" Width="18" Height="18"/>
                            <Path x:Name="CompactGenericIconPath" Fill="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 6 4 L 11 2.5 L 11 9.5 C 10.4 9.2 9.7 9 9 9 C 7.3 9 6 10.1 6 11.5 C 6 12.9 7.3 14 9 14 C 10.7 14 12 12.9 12 11.5 L 12 5 L 7 6.5 Z"/>
                        </Grid>
                    </Grid>

                    <!-- Mini title / active lyric ticker -->
                    <TextBlock x:Name="CompactLyricText"
                               Grid.Column="1"
                               Text="lysyn"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#E4E4E7"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="6,0" />

                    <!-- Mini right icon or avatar -->
                    <Border Grid.Column="2" Width="26" Height="26" CornerRadius="13" ClipToBounds="True" VerticalAlignment="Center">
                        <controls:GifPlayer x:Name="CompactGif" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- 2. EXPANDED FULL VIEW (Spacious height with reasonable breathing room) -->
                <Grid x:Name="ExpandedGrid" Visibility="Collapsed" Margin="16,12,16,14">
                    <!-- Subtle Pin Toggle in Top-Right Corner Overlay -->
                    <Button x:Name="PinButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Panel.ZIndex="10"
                            Style="{StaticResource TransportBtn}"
                            ToolTip="Pin notch expanded"
                            Margin="0,0,2,0"
                            Click="PinButton_Click">
                        <TextBlock x:Name="PinIconText" Text="📌" FontSize="11" Foreground="#52525B" />
                    </Button>

                    <!-- Overlapping 3-Section Content Grid -->
                    <Grid VerticalAlignment="Center" Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="155" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="155" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Circular Radial Visualizer with Center Album Art -->
                        <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:CircularVisualizer x:Name="RadialVisualizer" Width="148" Height="148" />
                        </Grid>

                        <!-- CENTER: Title, Artist, Clean Floating Lyrics, Player Controls from Image, Progress, Brand Badge -->
                        <Grid Grid.Column="1" Margin="6,0,6,0" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center">
                                <!-- Track Title (Spacious, bold, clear headroom) -->
                                <TextBlock x:Name="ExpandedTitleText"
                                           Text="Waiting for media..."
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#FAFAFA"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="380"
                                           Margin="0,0,0,2" />

                                <!-- Artist & Album Subtitle -->
                                <TextBlock x:Name="ExpandedArtistText"
                                           Text="Start music in Spotify, YouTube Music, or player"
                                           FontSize="11"
                                           Foreground="#A1A1AA"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="370"
                                           Margin="0,0,0,8" />

                                <!-- Floating Synchronized Lyrics (No background div/box as requested) -->
                                <StackPanel Margin="0,0,0,12" HorizontalAlignment="Center">
                                    <!-- Previous Line -->
                                    <TextBlock x:Name="PrevLineText"
                                               Text=""
                                               FontSize="10.5"
                                               Foreground="#52525B"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="360"
                                               Margin="0,0,0,3" />

                                    <!-- Active / Current Line (Highlighted with Amber Glow) -->
                                    <TextBlock x:Name="CurrentLineText"
                                               Text="Connect your music player (Spotify, Browser, etc.)"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#FEF08A"
                                               Effect="{StaticResource TextGlow}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="370"
                                               Margin="0,0,0,3" />

                                    <!-- Next Line -->
                                    <TextBlock x:Name="NextLineText"
                                               Text=""
                                               FontSize="10.5"
                                               Foreground="#71717A"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="360" />
                                </StackPanel>

                                <!-- Media Playback Vector Transport Controls (From Reference Image) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <!-- Previous Track Button (Rounded Vertical Bar + Dual Left Triangles: |◀◀) -->
                                    <Button x:Name="PrevTrackBtn" Style="{StaticResource TransportBtn}" Width="40" Height="36" Margin="6,0" Click="PrevTrackBtn_Click" ToolTip="Previous Track">
                                        <Canvas Width="20" Height="16">
                                            <!-- Rounded Vertical Bar on Left -->
                                            <Rectangle Width="2.8" Height="15" RadiusX="1.4" RadiusY="1.4" Fill="#E4E4E7" Canvas.Left="0.5" Canvas.Top="0.5"/>
                                            <!-- First Triangle (pointing left) -->
                                            <Path Fill="#E4E4E7" Data="M 10 1.5 L 3.5 8 L 10 14.5 Z"/>
                                            <!-- Second Triangle (pointing left) -->
                                            <Path Fill="#E4E4E7" Data="M 18.5 1.5 L 12 8 L 18.5 14.5 Z"/>
                                        </Canvas>
                                    </Button>

                                    <!-- Play / Pause Squircle Button (From Reference Image) -->
                                    <Button x:Name="PlayPauseBtn" Style="{StaticResource PlaySquircleBtn}" Width="44" Height="44" Margin="14,0" Click="PlayPauseBtn_Click" ToolTip="Play / Pause">
                                        <Grid Width="20" Height="20">
                                            <!-- Play Triangle (Shown when paused) -->
                                            <Path x:Name="PlayPath" Fill="#000000" Data="M 4 2 L 16 10 L 4 18 Z" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"/>
                                            <!-- Pause Dual Rounded Vertical Bars (Shown when playing, from image) -->
                                            <Canvas x:Name="PausePath" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                                <Rectangle Width="4.2" Height="15" RadiusX="2.1" RadiusY="2.1" Fill="#000000" Canvas.Left="2" Canvas.Top="0.5"/>
                                                <Rectangle Width="4.2" Height="15" RadiusX="2.1" RadiusY="2.1" Fill="#000000" Canvas.Left="9.8" Canvas.Top="0.5"/>
                                            </Canvas>
                                        </Grid>
                                    </Button>

                                    <!-- Next Track Button (Dual Right Triangles + Rounded Vertical Bar: ▶▶|) -->
                                    <Button x:Name="NextTrackBtn" Style="{StaticResource TransportBtn}" Width="40" Height="36" Margin="6,0" Click="NextTrackBtn_Click" ToolTip="Next Track">
                                        <Canvas Width="20" Height="16">
                                            <!-- First Triangle (pointing right) -->
                                            <Path Fill="#E4E4E7" Data="M 1.5 1.5 L 8 8 L 1.5 14.5 Z"/>
                                            <!-- Second Triangle (pointing right) -->
                                            <Path Fill="#E4E4E7" Data="M 10 1.5 L 16.5 8 L 10 14.5 Z"/>
                                            <!-- Rounded Vertical Bar on Right -->
                                            <Rectangle Width="2.8" Height="15" RadiusX="1.4" RadiusY="1.4" Fill="#E4E4E7" Canvas.Left="16.7" Canvas.Top="0.5"/>
                                        </Canvas>
                                    </Button>
                                </StackPanel>

                                <!-- Timeline Progress with Timestamps & Scrub Thumb -->
                                <Grid Margin="10,0,10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Elapsed Time -->
                                    <TextBlock x:Name="ElapsedText" Grid.Column="0" Text="0:00" FontSize="10.5" Foreground="#A1A1AA" VerticalAlignment="Center" HorizontalAlignment="Left" />

                                    <!-- Progress Track -->
                                    <Grid Grid.Column="1" Height="14" Margin="6,0" Cursor="Hand" MouseLeftButtonDown="ProgressBar_MouseLeftButtonDown">
                                        <!-- Background Bar -->
                                        <Rectangle Height="3.5" Fill="#27272A" RadiusX="2" RadiusY="2" VerticalAlignment="Center" />
                                        <!-- Active Fill -->
                                        <Rectangle x:Name="ProgressBarFill" Height="3.5" Fill="#F59E0B" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" Width="0" VerticalAlignment="Center" />
                                        <!-- Theme Scrub Thumb -->
                                        <Ellipse x:Name="ProgressThumb" Width="10" Height="10" Fill="#F59E0B" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-5,0,0,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="ProgressThumbGlow" Color="#F59E0B" BlurRadius="6" ShadowDepth="0" Opacity="0.85" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Grid>

                                    <!-- Total Time -->
                                    <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="0:00" FontSize="10.5" Foreground="#71717A" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Media Source Brand Badge Pill (Spotify, YouTube, YouTube Music, Apple Music, Generic) -->
                                <Border HorizontalAlignment="Center" Background="#141416" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="10,2.5" Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Spotify Brand Vector Icon -->
                                        <Grid x:Name="SpotifyLogoGrid" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Visible">
                                            <Ellipse Fill="#1DB954" Width="14" Height="14"/>
                                            <Path Stroke="#000000" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M 3.2 5.2 C 6.5 4.0 10.2 4.5 12.2 6.1"/>
                                            <Path Stroke="#000000" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M 3.8 8.0 C 6.6 7.1 9.8 7.5 11.4 8.7"/>
                                            <Path Stroke="#000000" StrokeThickness="0.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M 4.4 10.6 C 6.6 9.9 9.1 10.2 10.5 11.2"/>
                                        </Grid>

                                        <!-- YouTube Video / Standard Vector Icon (Red rounded rect + centered white triangle) -->
                                        <Grid x:Name="YouTubeStandardLogoGrid" Width="16" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Viewbox Width="16" Height="11.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="20" Height="14">
                                                    <Rectangle Width="20" Height="14" RadiusX="4.2" RadiusY="4.2" Fill="#FF0000"/>
                                                    <Path Fill="#FFFFFF" Data="M 7.5 3.5 L 13.5 7 L 7.5 10.5 Z"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>

                                        <!-- YouTube Music Vector Icon (Red circle + centered white concentric ring + triangle) -->
                                        <Grid x:Name="YouTubeMusicLogoGrid" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="20" Height="20">
                                                    <Ellipse Width="20" Height="20" Fill="#FF0000"/>
                                                    <Ellipse Canvas.Left="4" Canvas.Top="4" Width="12" Height="12" Stroke="#FFFFFF" StrokeThickness="1.4"/>
                                                    <Path Fill="#FFFFFF" Data="M 8.5 6.5 L 13 10 L 8.5 13.5 Z"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>

                                        <!-- Apple Music Vector Icon -->
                                        <Grid x:Name="AppleLogoGrid" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Ellipse Fill="#FA2D48" Width="14" Height="14"/>
                                            <Path Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 5 3.8 L 9 2.7 L 9 8.2 C 8.5 8 8 7.9 7.5 7.9 C 6.4 7.9 5.5 8.7 5.5 9.6 C 5.5 10.5 6.4 11.3 7.5 11.3 C 8.6 11.3 9.5 10.5 9.5 9.6 L 9.5 4.7 L 5.8 5.7 Z"/>
                                        </Grid>

                                        <!-- Generic Media Vector Icon -->
                                        <Grid x:Name="GenericLogoGrid" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Ellipse x:Name="GenericLogoEllipse" Fill="#F59E0B" Width="14" Height="14"/>
                                            <Path Fill="#000000" Data="M 5 4 L 10 7 L 5 10 Z"/>
                                        </Grid>

                                        <TextBlock x:Name="SourceAppBadgeText" Text="Spotify" FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- RIGHT: The User's Animated GIF -->
                        <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="150" Height="150" CornerRadius="12" ClipToBounds="True">
                                <controls:GifPlayer x:Name="RightCharGif" Width="145" Height="145" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
